{
  "name": "neon3-inventory-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/src/inventory.js",
    "case:window": "npm run build && node dist/src/case-window.js",
    "probe": "npm run build && node dist/src/probe.js --once --diagnostic",
    "cases": "npm run build && node dist/src/run.js",
    "cases:runtime": "npm run build && node dist/src/run.js --runtime --timeout-ms 9000"
  },
  "dependencies": {
    "@neon3/sdk": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
